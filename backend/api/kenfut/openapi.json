  "components": {
    "schemas": {
      "ContentMetadata": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": [
              "docs",
              "article",
              "both"
            ]
          },
          "slug": {
            "type": "string"
          },
          "cover_url": {
            "type": "string"
          },
          "author_name": {
            "type": "string"
          },
          "author_avatar": {
            "type": "string"
          },
          "display_date": {
            "type": "string",
            "format": "date-time"
          },
          "category": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "featured": {
            "type": "boolean"
          },
          "featured_order": {
            "type": "integer"
          },
          "related_node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ctas": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "$ref": "#/components/schemas/CTA"
            }
          }
        }
      },
      "ContentItem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ContentMetadata"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kb_id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "content_type": {
                "type": "string"
              },
              "canonical_url": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "node_release_id": {
                "type": "string"
              }
            }
          }
        ]
      },
      "LinkTarget": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "node",
              "site",
              "product",
              "url"
            ]
          },
          "node_id": {
            "type": "string"
          },
          "page": {
            "type": "string",
            "enum": [
              "home",
              "docs",
              "blog"
            ]
          },
          "product_id": {
            "type": "string"
          },
          "page_key": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "CTA": {
        "type": "object",
        "required": [
          "id",
          "label",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/LinkTarget"
          },
          "style": {
            "type": "string",
            "enum": [
              "primary",
              "secondary"
            ]
          },
          "new_tab": {
            "type": "boolean"
          }
        }
      },
      "Conversion": {
        "type": "object",
        "required": [
          "event_id",
          "event_type",
          "occurred_at",
          "subject_id"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "registered",
              "first_generation_success"
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "subject_id": {
            "type": "string",
            "maxLength": 256
          },
          "click_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "kb_id",
          "name",
          "origin",
          "pages",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kb_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "origin": {
            "type": "string",
            "format": "uri"
          },
          "enabled": {
            "type": "boolean"
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "name",
                "path"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "parameters": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "AdminBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "ProductBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
