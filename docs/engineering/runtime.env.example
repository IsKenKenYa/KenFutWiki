# Verification uses only an isolated test database. Do not point this at business data.
GOTOOLCHAIN=go1.24.3
KENFUT_TEST_DSN=host=127.0.0.1 port=55437 user=local_user dbname=kenfutwiki_test sslmode=disable

# Public web runtime points to the API service. Production ingress supplies X-KB-ID.
TARGET=http://127.0.0.1:8080
NEXT_PUBLIC_SOURCE_URL=https://github.com/IsKenKenYa/KenFutWiki/tree/DEPLOYED_COMMIT
VITE_APP_SOURCE_URL=https://github.com/IsKenKenYa/KenFutWiki/tree/DEPLOYED_COMMIT

# Product credentials belong to the product's server, never to NEXT_PUBLIC_/VITE_ variables.
KENFUT_BASE_URL=https://docs.example.com
KENFUT_PRODUCT_TOKEN=REPLACE_WITH_SERVER_ONLY_PRODUCT_CREDENTIAL

# Telemetry is opt-in and uses your own project settings.
ENABLE_SENTRY=false
NEXT_PUBLIC_ENABLE_SENTRY=false
